{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starter.local/schemas/saas-capability-matrix.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "statusPolicy", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "starter-saas-capability-matrix/v1" },
    "statusPolicy": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceIds",
          "owner",
          "delivery",
          "status",
          "routes",
          "apis",
          "schema",
          "verification"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "owner": { "type": "string", "minLength": 1 },
          "delivery": { "enum": ["baseline", "materializer", "planned"] },
          "status": {
            "enum": [
              "planned",
              "partial",
              "implemented",
              "local-verified",
              "development-verified",
              "production-released"
            ]
          },
          "routes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "apis": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "verification": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "gaps": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
