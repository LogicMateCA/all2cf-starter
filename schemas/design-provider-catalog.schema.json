{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starter.local/schemas/design-provider-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "policy", "providers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "starter-design-provider-catalog/v1" },
    "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "policy": { "type": "string", "minLength": 1 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "status", "selectionMode", "distribution", "source", "notes", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["global-style", "dynamic-component", "design-recipe"] },
          "status": { "enum": ["local-verified", "catalog-ready", "reference-ready", "planned"] },
          "selectionMode": { "enum": ["single-required", "multiple-optional"] },
          "distribution": { "enum": ["starter-owned-snapshots", "upstream-package", "upstream-registry", "adapted-recipe-reference"] },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "revision", "license"],
            "properties": {
              "url": { "type": "string", "pattern": "^https://" },
              "revision": { "type": "string", "minLength": 4 },
              "license": { "type": "string", "minLength": 1 }
            }
          },
          "notes": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "category", "install", "performance", "targets", "requires"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
                "name": { "type": "string", "minLength": 1 },
                "category": { "type": "string", "minLength": 1 },
                "install": { "type": "string", "minLength": 1 },
                "performance": { "enum": ["light", "moderate", "heavy"] },
                "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["marketing", "desktop-web", "admin", "docs"] } },
                "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  }
}
