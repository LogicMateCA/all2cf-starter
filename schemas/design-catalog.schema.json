{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starter.local/schemas/design-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "sourcePolicy", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "starter-design-catalog/v1" },
    "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourcePolicy": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "packId", "name", "description", "status", "targets", "source", "direction", "semanticColors", "rules", "adapters", "quality"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "packId": { "type": "string", "pattern": "^design\\.[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "status": { "enum": ["defined", "local-verified", "development-verified", "production-released"] },
          "targets": { "type": "array", "items": { "enum": ["marketing", "desktop-web", "admin", "docs", "mobile"] }, "uniqueItems": true },
          "source": { "type": "array" },
          "direction": { "type": "object" },
          "semanticColors": { "type": "object", "required": ["light", "dark"] },
          "rules": { "type": "object", "required": ["do", "dont"] },
          "adapters": { "type": "object" },
          "quality": { "type": "object" }
        }
      }
    }
  }
}
