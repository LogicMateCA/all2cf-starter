{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starter.local/schemas/saas-source-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "starter-saas-source-manifest/v1" },
    "policy": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "repository",
          "revision",
          "license",
          "licenseSha256",
          "relationship",
          "role",
          "accepted",
          "rejected",
          "updatePolicy"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string" },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"
          },
          "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "license": { "const": "MIT" },
          "licenseSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "relationship": { "enum": ["adapted-donor", "reference-checklist"] },
          "role": { "type": "string", "minLength": 1 },
          "accepted": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope", "sourcePaths", "targetPaths"],
              "properties": {
                "scope": {
                  "enum": ["structure-and-interactions", "capability-checklist"]
                },
                "sourcePaths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "targetPaths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                }
              }
            }
          },
          "rejected": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "updatePolicy": {
            "enum": ["manual-reviewed", "pinned-checklist-review"]
          }
        }
      }
    }
  }
}
