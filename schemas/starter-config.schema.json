{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project", "cloudflare", "email", "local", "development", "production"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
      }
    },
    "cloudflare": {
      "type": "object",
      "required": ["accountId", "zoneId", "zoneName"]
    },
    "email": {
      "type": "object",
      "required": ["provider", "resendApiUrl"],
      "properties": {
        "provider": { "type": "string", "enum": ["cfsend", "resend", "cloudflare-email"] },
        "resendApiUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "local": { "$ref": "#/$defs/localEnvironment" },
    "development": { "$ref": "#/$defs/environment" },
    "production": { "$ref": "#/$defs/environment" }
  },
  "$defs": {
    "localEnvironment": {
      "type": "object",
      "required": ["worker", "domain", "runtime", "database"],
      "properties": {
        "worker": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "pattern": "^https?://(localhost|127\\.0\\.0\\.1)(:[0-9]{1,5})?$" },
        "runtime": { "enum": ["vite-and-workerd"] },
        "database": {
          "type": "object",
          "required": ["connection", "tunnelId", "host", "port", "database", "user"],
          "properties": {
            "connection": { "const": "tunnel-direct" },
            "tunnelId": { "type": "string", "minLength": 1 },
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "database": { "type": "string", "minLength": 1 },
            "user": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["worker", "domain", "wranglerConfig", "database"],
      "properties": {
        "worker": { "type": "string" },
        "domain": { "type": "string" },
        "wranglerConfig": { "type": "string" },
        "database": { "type": "object", "required": ["database", "user", "host", "port", "hyperdriveName"] }
      }
    }
  }
}
