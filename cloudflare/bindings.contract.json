{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Starter Cloudflare bindings contract",
  "description": "Reserved binding names and isolation rules. Provision concrete resources separately; this contract intentionally contains no account, database, bucket, queue, or secret IDs.",
  "environments": {
    "development": {
      "worker": "starter-dev",
      "resourceIsolation": "Development resources only; never point at production resources."
    },
    "production": {
      "worker": "starter",
      "resourceIsolation": "Production resources only; never share mutable development resources."
    }
  },
  "bindings": {
    "HYPERDRIVE": {
      "kind": "hyperdrive",
      "status": "selected-native-postgresql",
      "requiredPerEnvironment": false,
      "requiredWhen": "database.provider=native-postgresql"
    },
    "ALL2CF_DATABASE": {
      "kind": "service_binding",
      "status": "selected-cfpg",
      "requiredPerEnvironment": false,
      "requiredWhen": "database.provider=cfpg",
      "entrypoint": "All2CFDatabase",
      "mutuallyExclusiveWith": "HYPERDRIVE"
    },
    "STARTER_R2": {
      "kind": "r2_bucket",
      "status": "future",
      "requiredPerEnvironment": true
    },
    "STARTER_QUEUE": {
      "kind": "queue",
      "status": "future",
      "requiredPerEnvironment": true
    },
    "STARTER_DLQ": {
      "kind": "queue",
      "status": "future",
      "requiredPerEnvironment": true
    },
    "CFSEND": {
      "kind": "service_binding",
      "status": "future",
      "requiredPerEnvironment": true
    },
    "GOOGLE_CLIENT_ID": {
      "kind": "secret",
      "status": "selectable-social-provider",
      "requiredPerEnvironment": false
    },
    "GOOGLE_CLIENT_SECRET": {
      "kind": "secret",
      "status": "selectable-social-provider",
      "requiredPerEnvironment": false
    },
    "GITHUB_CLIENT_ID": {
      "kind": "secret",
      "status": "selectable-social-provider",
      "requiredPerEnvironment": false
    },
    "GITHUB_CLIENT_SECRET": {
      "kind": "secret",
      "status": "selectable-social-provider",
      "requiredPerEnvironment": false
    },
    "APPLE_CLIENT_ID": {
      "kind": "secret",
      "status": "selectable-social-provider",
      "requiredPerEnvironment": false
    },
    "APPLE_TEAM_ID": {
      "kind": "secret",
      "status": "selectable-social-provider",
      "requiredPerEnvironment": false
    },
    "APPLE_KEY_ID": {
      "kind": "secret",
      "status": "selectable-social-provider",
      "requiredPerEnvironment": false
    },
    "APPLE_PRIVATE_KEY_BASE64": {
      "kind": "secret",
      "status": "selectable-social-provider",
      "requiredPerEnvironment": false
    },
    "APPLE_APP_BUNDLE_IDENTIFIER": {
      "kind": "secret",
      "status": "selectable-social-provider",
      "requiredPerEnvironment": false
    },
    "STRIPE_SECRET_KEY": {
      "kind": "secret",
      "status": "optional-billing-pack",
      "requiredPerEnvironment": false
    },
    "STRIPE_WEBHOOK_SECRET": {
      "kind": "secret",
      "status": "optional-billing-pack",
      "requiredPerEnvironment": false
    },
    "STRIPE_PRICE_PRO": {
      "kind": "secret",
      "status": "optional-billing-pack",
      "requiredPerEnvironment": false
    },
    "AUTH": {
      "kind": "service_binding",
      "status": "future",
      "requiredPerEnvironment": true
    }
  }
}
