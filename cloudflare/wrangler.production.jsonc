{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "starter",
  "main": "../workers/app/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production"
  },
  "assets": {
    "directory": "../dist/web",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d06b8bceb83b4ad38dfbb6648a9c927f"
    }
  ],
  "routes": [
    {
      "pattern": "starter.logicm8.com",
      "custom_domain": true
    }
  ]
}
