{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "starter",
  "main": "../workers/app/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "SERVICE_NAME": "starter",
    "APP_NAME": "Cloudflare AI Starter",
    "AUTH_CANONICAL_ORIGIN": "https://starter.logicm8.com",
    "AUTH_REQUIRE_EMAIL_VERIFICATION": "true",
    "AUTH_EMAIL_PROVIDER": "cfsend",
    "RESEND_API_URL": "https://api.resend.com",
    "MOBILE_DEEP_LINK_SCHEMES": "starter-dev://,starter-preview://,starter://"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "CFSEND_API_KEY",
      "CFSEND_API_URL",
      "CFSEND_FROM",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "assets": {
    "directory": "../dist/web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/login",
      "/app",
      "/app/*",
      "/support",
      "/support/*",
      "/admin",
      "/admin/*",
      "/dp",
      "/setup",
      "/setup/*",
      "/__starter/*"
    ],
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d06b8bceb83b4ad38dfbb6648a9c927f"
    }
  ],
  "routes": [
    {
      "pattern": "starter.logicm8.com",
      "custom_domain": true
    }
  ]
}
