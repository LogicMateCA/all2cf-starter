{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "starter-all2cf",
  "main": "../workers/app/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "SERVICE_NAME": "starter",
    "APP_NAME": "All2CF Starter",
    "DATABASE_PROVIDER": "native-postgresql",
    "AUTH_CANONICAL_ORIGIN": "https://starter.all2cf.com",
    "AUTH_REQUIRE_EMAIL_VERIFICATION": "true",
    "AUTH_EMAIL_PROVIDER": "cfsend",
    "RESEND_API_URL": "https://api.resend.com",
    "MOBILE_DEEP_LINK_SCHEMES": "starter-dev://,starter-preview://,starter://",
    "AUTH_SOCIAL_PROVIDERS": "google",
    "STORAGE_PROVIDER": "cloudflare-r2",
    "STORAGE_BUCKET": "starter-objects",
    "STORAGE_ACCESS": "private",
    "STORAGE_MAX_UPLOAD_BYTES": "10485760",
    "STORAGE_PUBLIC_DOMAIN": ""
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "CFSEND_API_KEY",
      "CFSEND_API_URL",
      "CFSEND_FROM",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "STRIPE_PRICE_PRO",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "WEBHOOK_SIGNING_KEY"
    ]
  },
  "assets": {
    "directory": "../dist/web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/login",
      "/dashboard",
      "/dashboard/*",
      "/app",
      "/app/*",
      "/support",
      "/support/*",
      "/admin",
      "/admin/*",
      "/dp",
      "/setup",
      "/setup/*",
      "/__starter/*"
    ],
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d06b8bceb83b4ad38dfbb6648a9c927f"
    }
  ],
  "routes": [
    {
      "pattern": "starter.all2cf.com/dashboard*",
      "zone_name": "all2cf.com"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "OUTGOING_WEBHOOK_QUEUE",
        "queue": "starter-outgoing-webhooks"
      }
    ],
    "consumers": [
      {
        "queue": "starter-outgoing-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "retry_delay": 10,
        "max_concurrency": 10
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "starter-objects"
    }
  ],
  "triggers": {
    "crons": []
  }
}
