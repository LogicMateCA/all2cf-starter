{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "starter-dev",
  "main": "../workers/app/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development"
  },
  "assets": {
    "directory": "../dist/web",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
