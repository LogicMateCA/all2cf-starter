{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "starter-dev",
  "main": "../workers/app/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "SERVICE_NAME": "starter",
    "APP_NAME": "Cloudflare AI Starter",
    "AUTH_CANONICAL_ORIGIN": "https://dev.logicm8.com",
    "AUTH_REQUIRE_EMAIL_VERIFICATION": "true",
    "AUTH_EMAIL_PROVIDER": "cfsend",
    "RESEND_API_URL": "https://api.resend.com",
    "MOBILE_DEEP_LINK_SCHEMES": "starter-dev://,starter-preview://,starter://"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "CFSEND_API_URL", "CFSEND_API_KEY", "CFSEND_FROM"]
  },
  "assets": {
    "directory": "../dist/web",
    "run_worker_first": [
      "/api/*",
      "/setup",
      "/setup/*",
      "/__starter/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d665e59cdc9741c1898ba7c472c22abf"
    }
  ],
  "routes": [
    {
      "pattern": "dev.logicm8.com",
      "custom_domain": true
    }
  ]
}
