---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageIntro from "../../components/PageIntro.astro";
const roles = (await getCollection("careers", ({ data }) => !data.draft)).sort((a, b) => b.data.postedAt.valueOf() - a.data.postedAt.valueOf());
---
<Base title="Careers"><PageIntro title="Open roles belong to real teams." description="Publish a role only when its owner, location, terms and application destination are configured." /><section class="content-section" aria-labelledby="roles-heading"><h2 id="roles-heading">Open roles</h2>{roles.length ? <div class="role-list">{roles.map((role) => <a href={`/careers/${role.id}`}><span><strong>{role.data.title}</strong><small>{role.data.team} · {role.data.sample ? "Starter sample" : role.data.employmentType}</small></span><span>{role.data.location} · {role.data.workplace}</span></a>)}</div> : <div class="empty-state"><h2>No open roles.</h2><p>Add a real role only after its application path is configured.</p></div>}</section></Base>
