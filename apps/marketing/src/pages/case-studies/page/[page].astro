---
import type { GetStaticPaths, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import PageIntro from "../../../components/PageIntro.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const cases = (await getCollection("case-studies", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
  return paginate(cases, { pageSize: 6 }).filter(({ params }) => params.page !== "1");
}) satisfies GetStaticPaths;
const { page } = Astro.props as { page: Page<CollectionEntry<"case-studies">> };
---
<Base title={`Case studies — page ${page.currentPage}`}><PageIntro title={`Case studies — page ${page.currentPage}`} description="More reviewed outcomes from the same evidence model." /><section class="content-section"><div class="growth-grid">{page.data.map((item) => <article class="growth-card"><div class="growth-meta"><span>{item.data.sample ? "Starter sample" : item.data.customer}</span><span>{item.data.industry}</span></div><h3><a href={`/case-studies/${item.id}`}>{item.data.title}</a></h3><p>{item.data.summary}</p></article>)}</div><nav class="collection-pagination" aria-label="Case study pagination">{page.url.prev ? <a href={page.url.prev}>Newer</a> : <span />}{page.url.next ? <a href={page.url.next}>Older</a> : <span />}</nav></section></Base>
