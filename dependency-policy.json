{
  "$schema": "./schemas/dependency-policy.schema.json",
  "stableOnly": true,
  "automaticMerge": false,
  "automaticProductionRelease": false,
  "externalPins": {
    "eas-cli": "22.0.0",
    "shadcn": "4.18.0"
  },
  "tracks": [
    {
      "id": "cloudflare-web-worker",
      "mode": "latest-stable",
      "packages": ["wrangler", "@cloudflare/workers-types", "hono", "pg", "vite", "@vitejs/plugin-react", "tailwindcss", "@tailwindcss/vite", "lucide-react", "recharts", "clsx", "tailwind-merge", "class-variance-authority", "radix-ui", "shadcn"]
    },
    {
      "id": "expo-sdk",
      "mode": "expo-compatible",
      "packages": ["expo", "react-native", "react", "react-native-web", "expo-router", "expo-updates", "expo-dev-client", "expo-network", "expo-web-browser", "expo-secure-store", "@expo/fingerprint", "@tamagui/core", "@tamagui/stacks", "@tamagui/text", "@tamagui/button", "@tamagui/input", "@tamagui/label", "@tamagui/shapes", "@tamagui/spinner", "@tamagui/shorthands", "eas-cli"]
    },
    {
      "id": "better-auth",
      "mode": "aligned-latest-stable",
      "packages": ["better-auth", "@better-auth/expo", "auth", "@better-auth/stripe"],
      "companions": ["stripe"],
      "requirements": ["same Better Auth release line", "review official migration notes", "generate and review SQL", "verify auth and Stripe flows", "revalidate the Metro focused cookie-utils resolver"]
    }
  ]
}
