{
  "$schema": "../../../schemas/starter-pack.schema.json",
  "schemaVersion": "starter-pack/v1",
  "id": "saas.auth-scim",
  "version": "0.1.0",
  "source": {
    "name": "Better Auth SCIM",
    "url": "https://better-auth.com/docs/plugins/scim",
    "revision": "1.7.2",
    "license": "MIT",
    "relationship": "tracked-upstream"
  },
  "files": [
    {
      "source": "templates/scim-config.ts",
      "target": "workers/app/features/scim-config.ts"
    },
    {
      "source": "templates/scim-auth-plugin.ts",
      "target": "workers/app/features/scim-auth-plugin.ts"
    },
    {
      "source": "templates/scim-worker.ts",
      "target": "workers/app/features/scim-worker.ts"
    },
    {
      "source": "templates/0001_scim.sql",
      "target": "db/migrations/1016_scim.sql"
    }
  ],
  "dependencies": [
    {
      "packageFile": "workers/app/package.json",
      "section": "dependencies",
      "name": "@better-auth/scim",
      "version": "1.7.2"
    }
  ],
  "routes": [],
  "authPlugins": {
    "server": {
      "module": "../features/scim-auth-plugin",
      "export": "createScimAuthPlugin"
    }
  },
  "workerFeature": {
    "module": "../features/scim-worker",
    "export": "scimFeature"
  },
  "cloudflare": {
    "requiredSecrets": ["SCIM_CONNECTIONS_JSON"]
  }
}
