{
  "$schema": "../../../schemas/starter-pack.schema.json",
  "schemaVersion": "starter-pack/v1",
  "id": "saas.auth-device-authorization",
  "version": "0.1.0",
  "source": {
    "name": "Better Auth Device Authorization",
    "url": "https://better-auth.com/docs/plugins/device-authorization",
    "revision": "1.7.2",
    "license": "MIT",
    "relationship": "tracked-upstream"
  },
  "files": [
    {
      "source": "templates/device-auth-plugin.ts",
      "target": "workers/app/features/device-auth-plugin.ts"
    },
    {
      "source": "templates/device-auth-client-plugin.ts",
      "target": "apps/web/src/features/device-auth-client-plugin.ts"
    },
    {
      "source": "templates/device-page.tsx",
      "target": "apps/web/src/components/features/device-page.tsx"
    },
    {
      "source": "templates/device-page.css",
      "target": "apps/web/src/components/features/device-page.css"
    },
    {
      "source": "templates/0001_device_authorization.sql",
      "target": "db/migrations/1018_device_authorization.sql"
    }
  ],
  "dependencies": [
    {
      "packageFile": "workers/app/package.json",
      "section": "dependencies",
      "name": "@better-auth/oauth-provider",
      "version": "1.7.2"
    },
    {
      "packageFile": "apps/web/package.json",
      "section": "dependencies",
      "name": "@better-auth/oauth-provider",
      "version": "1.7.2"
    }
  ],
  "routes": [
    {
      "path": "/device",
      "module": "../components/features/device-page",
      "export": "DeviceAuthorizationPage",
      "workerFirst": false
    }
  ],
  "authPlugins": {
    "server": {
      "module": "../features/device-auth-plugin",
      "export": "createDeviceAuthPlugin"
    },
    "client": {
      "module": "../features/device-auth-client-plugin",
      "export": "createDeviceAuthClientPlugin"
    }
  },
  "requiresPacks": ["saas.auth-jwt", "saas.auth-oauth-provider"]
}
