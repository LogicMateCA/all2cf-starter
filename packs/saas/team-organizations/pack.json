{
  "$schema": "../../../schemas/starter-pack.schema.json",
  "schemaVersion": "starter-pack/v1",
  "id": "saas.team-organizations",
  "version": "0.3.0",
  "source": {
    "name": "Better Auth Organization",
    "url": "https://better-auth.com/docs/plugins/organization",
    "revision": "1.7.2",
    "license": "MIT",
    "relationship": "tracked-upstream"
  },
  "files": [
    {
      "source": "templates/organization-auth-plugin.ts",
      "target": "workers/app/features/organization-auth-plugin.ts"
    },
    {
      "source": "templates/organization-auth-client-plugin.ts",
      "target": "apps/web/src/features/organization-auth-client-plugin.ts"
    },
    {
      "source": "templates/organization-page.tsx",
      "target": "apps/web/src/components/features/organization-page.tsx"
    },
    {
      "source": "templates/organization-page.css",
      "target": "apps/web/src/components/features/organization-page.css"
    },
    {
      "source": "templates/0005_organization.sql",
      "target": "db/migrations/1001_organization.sql"
    }
  ],
  "dependencies": [],
  "routes": [
    {
      "path": "/app/team",
      "module": "../components/features/organization-page",
      "export": "OrganizationPage",
      "workerFirst": false
    },
    {
      "path": "/app/invitation",
      "module": "../components/features/organization-page",
      "export": "OrganizationInvitationPage",
      "workerFirst": false
    }
  ],
  "authPlugins": {
    "server": {
      "module": "../features/organization-auth-plugin",
      "export": "createOrganizationAuthPlugin"
    },
    "client": {
      "module": "../features/organization-auth-client-plugin",
      "export": "createOrganizationAuthClientPlugin"
    }
  }
}
