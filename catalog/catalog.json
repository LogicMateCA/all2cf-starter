        "page.core-product-site",
        "saas.identity-core",
        "saas.product-shell",
        "saas.notifications-core",
        "saas.product-operations-lite"
      ]
    },
    {
      "id": "team-saas",
      "name": "Team SaaS",
      "description": "SaaS Foundation plus organizations, invitations, roles, and Stripe subscriptions.",
      "selections": [
        "page.core-product-site",
        "saas.identity-core",
        "saas.product-shell",
        "saas.notifications-core",
        "saas.product-operations-lite",
        "saas.team-organizations",
        "saas.billing-stripe"
      ]
    },
    {
      "id": "api-saas",
      "name": "API SaaS",
      "description": "SaaS Foundation plus API keys, subscriptions, entitlements, usage quotas, signed webhooks, and a developer portal.",
      "selections": [
        "page.core-product-site",
        "saas.identity-core",
        "saas.product-shell",
        "saas.notifications-core",
        "saas.product-operations-lite",
        "saas.billing-stripe",
        "saas.entitlements",
        "saas.usage",
        "saas.api-keys",
        "saas.outgoing-webhooks",
        "saas.api-platform"
      ]
    },
