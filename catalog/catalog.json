{
  "$schema": "../schemas/starter-catalog.schema.json",
  "schemaVersion": "starter-catalog/v1",
  "catalogVersion": "1.0.0",
  "policies": {
    "betterAuth": "Better Auth core and every selected official plugin move as one stable-compatible version line with generated schema comparison and reviewed SQL migrations.",
    "databaseBaseline": "Every copied Starter project provisions new empty Development and Production PostgreSQL databases from the final selected-pack SQL baseline. Existing data, backfills, dual writes, and compatibility shims are out of scope.",
    "ownedAdapters": "StyleKit is the pinned classified design-source library, PowerAI is the pinned page/content donor, Open SaaS and SaaSBoard are pinned product-shell donors, LastSaaS is the completeness checklist, and MapCN is a capability donor. Accepted output is licensed, tested, versioned, Starter-owned, and Cloudflare-native without donor runtime dependencies.",
    "references": "Open Design and RunCopilot inform design research or extraction only. Donor Wasp, Prisma, Go, MongoDB, Next.js, Supabase, mock data, and hosted APIs never become generated runtime dependencies by default."
  },
  "presets": [
    {
      "id": "saas-foundation",
      "name": "SaaS Foundation",
      "description": "Required product platform with identity, account, Product Shell, notifications, core product pages, Docs, modular Admin seams, support and audit.",
