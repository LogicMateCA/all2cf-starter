{
  "$schema": "../schemas/starter-catalog.schema.json",
  "schemaVersion": "starter-catalog/v1",
  "catalogVersion": "0.4.0",
  "policies": {
    "betterAuth": "Better Auth core and every selected official plugin move as one stable-compatible version line with generated schema comparison and reviewed SQL migrations.",
    "ownedAdapters": "StyleKit, PowerAI, and MapCN are donor inputs. Accepted code is adapted, licensed, tested, versioned, and maintained by Starter without automatic upstream source sync.",
    "references": "OpenSaaS, LastSaaS, Open Design, and RunCopilot inform product logic or extraction only and never become runtime dependencies by default."
  },
  "presets": [
    {
      "id": "basic-product",
      "name": "Basic Product",
      "description": "Identity, account, core product pages, docs, lightweight Admin, and support intake.",
      "selections": ["page.core-product-site", "saas.identity-core", "saas.product-operations-lite"]
    },
    {
      "id": "team-saas",
      "name": "Team SaaS",
      "description": "Basic Product plus organizations, invitations, roles, and Stripe subscriptions.",
      "selections": ["page.core-product-site", "saas.identity-core", "saas.product-operations-lite", "saas.team-organizations", "saas.billing-stripe"]
    },
    {
      "id": "api-platform",
      "name": "API Platform",
      "description": "Basic Product plus API keys, signed webhooks, usage, and optional billing foundations.",
      "selections": ["page.core-product-site", "saas.identity-core", "saas.product-operations-lite", "saas.api-platform"]
    },
    {
      "id": "custom",
      "name": "Custom",
      "description": "Start with the required core and select additional packs explicitly.",
      "selections": ["page.core-product-site", "saas.identity-core", "saas.product-operations-lite"]
    }
  ],
  "packs": [
    {
      "id": "design.owned-neutral",
      "kind": "design",
      "name": "Owned neutral foundation",
      "version": "0.1.0",
      "status": "production-released",
      "targets": ["desktop-web", "mobile-web", "ios", "android", "admin", "docs"],
      "ownership": "starter-owned",
      "source": [],
      "updatePolicy": "internal-curated",
      "provides": ["semantic color tokens", "light and dark modes", "shadcn Web primitives", "lean Tamagui mobile tokens"],
      "requires": ["accessibility states", "bundle budgets"],
      "conflicts": ["a second full component system on the same target"],
      "performance": ["route-level lazy loading", "package-level Tamagui imports"],
      "verification": ["Web build", "Web bundle budget", "mobile export and bundle budget"],
      "documentation": ["DESIGN.md", "features/mobile/MODULE.md"]
    },
    {
      "id": "design.stylekit-adapted",
      "kind": "design",
      "name": "StyleKit-derived design profiles",
      "version": "0.1.0",
      "status": "defined",
      "targets": ["desktop-web", "mobile-web", "ios", "android", "admin", "docs"],
      "ownership": "starter-owned",
      "source": [
        {
          "name": "StyleKit",
          "url": "https://github.com/AnxForever/stylekit",
          "revision": "29141b684d5abb967558eb8083fbae91dbbc51b8",
          "license": "MIT",
          "relationship": "adapted-donor"
        }
      ],
      "updatePolicy": "internal-curated",
      "provides": ["versioned design profiles", "semantic tokens", "component recipes", "platform adapters"],
      "requires": ["Taste review", "Astro, shadcn, Starlight, and Tamagui adapters"],
      "conflicts": ["direct StyleKit runtime calls", "unadapted upstream theme import"],
      "performance": ["compile-time tokens", "no StyleKit runtime dependency", "per-target asset budgets"],
      "verification": ["reference screenshots", "WCAG checks", "Core Web Vitals", "mobile bundle checks"],
      "documentation": ["DESIGN.md", "features/assembler/MODULE.md"]
    },
    {
      "id": "page.core-product-site",
      "kind": "page",
      "name": "Core product site",
      "version": "0.1.0",
      "status": "defined",
      "targets": ["desktop-web", "docs"],
      "ownership": "starter-owned",
      "source": [
        {
          "name": "PowerAI Astro",
          "url": "https://github.com/sitepins/powerai-astro",
          "revision": "a1176bf882bf0b1af98115f3280c2a6928e69261",
          "license": "MIT",
          "relationship": "adapted-donor"
        }
      ],
      "updatePolicy": "internal-curated",
      "provides": ["home", "features", "pricing", "about", "contact", "changelog", "privacy", "terms", "404", "auth entry", "Starlight docs"],
      "requires": ["selected design profile", "project content brief", "SEO metadata"],
      "conflicts": ["runtime feature flags for unselected pages", "PowerAI brand or theme leakage"],
      "performance": ["static-first Astro output", "route-specific islands", "image and font budgets"],
      "verification": ["route inventory", "responsive screenshots", "accessibility", "Lighthouse"],
      "documentation": ["ARCHITECTURE.md", "DESIGN.md", "features/docs/MODULE.md"]
    },
    {
      "id": "page.optional-growth",
      "kind": "page",
      "name": "Optional growth pages",
      "version": "0.1.0",
      "status": "defined",
      "targets": ["desktop-web"],
      "ownership": "starter-owned",
      "source": [],
      "updatePolicy": "internal-curated",
      "provides": ["blog", "case studies", "careers", "integrations", "comparison", "roadmap", "newsletter", "campaign landing pages"],
      "requires": ["explicit Blueprint selection"],
      "conflicts": ["generating unselected routes"],
      "performance": ["static-first output", "no unused client bundles"],
      "verification": ["selected-route parity", "SEO metadata", "visual QA"],
      "documentation": ["ARCHITECTURE.md", "DESIGN.md"]
    },
    {
      "id": "saas.identity-core",
      "kind": "saas",
      "name": "Identity and account core",
      "version": "0.1.0",
      "status": "development-verified",
      "targets": ["desktop-web", "mobile-web", "ios", "android", "worker"],
      "ownership": "upstream-tracked",
      "source": [
        {
          "name": "Better Auth",
          "url": "https://better-auth.com",
          "relationship": "tracked-upstream"
        }
      ],
      "updatePolicy": "stable-aligned",
      "provides": ["email and Google identity", "mandatory email verification", "host-only sessions", "account preferences", "Expo auth contract"],
      "requires": ["PostgreSQL", "CFsend or selected email adapter", "Better Auth aligned plugin versions"],
      "conflicts": ["independently versioned Better Auth plugins", "ORM-generated production migrations"],
      "performance": ["request-scoped Hyperdrive pool", "route-lazy Web client"],
      "verification": ["generated auth schema diff", "email provider contract", "auth smoke", "Development release"],
      "documentation": ["features/auth/MODULE.md", "ARCHITECTURE.md"]
    },
    {
      "id": "saas.product-operations-lite",
      "kind": "saas",
      "name": "Lightweight product operations",
      "version": "0.1.0",
      "status": "local-verified",
      "targets": ["desktop-web", "worker", "admin", "docs"],
      "ownership": "starter-owned",
      "source": [
        { "name": "OpenSaaS", "relationship": "reference" },
        { "name": "LastSaaS", "relationship": "reference" }
      ],
      "updatePolicy": "reference-only",
      "provides": ["Better Auth Admin platform roles and user readback", "minimal admin shell", "lightweight support and bug intake", "append-only privileged mutation evidence"],
      "requires": ["identity core", "explicit module selection"],
      "conflicts": ["full helpdesk scope", "unselected organization or billing schema"],
      "performance": ["admin-only route chunks", "no support attachments until selected"],
      "verification": ["isolated empty-database schema creation", "permission matrix", "Better Auth Admin user readback", "support lifecycle and audit checks"],
      "documentation": ["features/admin/MODULE.md", "features/support/MODULE.md", "features/auth/MODULE.md"]
    },
    {
      "id": "saas.team-organizations",
      "kind": "saas",
      "name": "Teams and organizations",
      "version": "0.1.0",
      "status": "planned",
      "targets": ["desktop-web", "mobile-web", "ios", "android", "worker", "admin"],
      "ownership": "upstream-tracked",
      "source": [
        { "name": "Better Auth Organization plugin", "url": "https://better-auth.com/docs/plugins/organization", "relationship": "tracked-upstream" }
      ],
      "updatePolicy": "stable-aligned",
      "provides": ["organizations", "members", "invitations", "organization roles", "active organization"],
      "requires": ["identity core", "aligned Better Auth plugin line", "reviewed SQL migrations"],
      "conflicts": ["using organization roles as platform Admin roles"],
      "performance": ["bounded membership lookups", "no organization data on public routes"],
      "verification": ["invitation lifecycle", "role matrix", "cross-organization isolation", "Development auth regression"],
      "documentation": ["features/auth/MODULE.md", "features/admin/MODULE.md"]
    },
    {
      "id": "saas.billing-stripe",
      "kind": "saas",
      "name": "Stripe subscriptions",
      "version": "0.1.0",
      "status": "planned",
      "targets": ["desktop-web", "worker", "admin"],
      "ownership": "upstream-tracked",
      "source": [
        { "name": "Better Auth Stripe plugin", "url": "https://better-auth.com/docs/plugins/stripe", "relationship": "tracked-upstream" },
        { "name": "Stripe SDK", "url": "https://github.com/stripe/stripe-node", "relationship": "runtime-dependency" }
      ],
      "updatePolicy": "stable-aligned",
      "provides": ["Checkout", "subscriptions", "signed webhooks", "plans", "entitlement projection", "Admin billing readback"],
      "requires": ["identity core", "Stripe Test and Live configuration", "aligned Better Auth plugin line"],
      "conflicts": ["client-authoritative entitlements", "unsigned webhook processing"],
      "performance": ["webhook work is replay-safe", "billing client excluded from public routes"],
      "verification": ["Checkout", "signed webhook", "subscription lifecycle", "replay", "entitlement regression"],
      "documentation": ["features/billing/MODULE.md", "features/admin/MODULE.md"]
    },
    {
      "id": "saas.api-platform",
      "kind": "saas",
      "name": "API platform foundation",
      "version": "0.1.0",
      "status": "planned",
      "targets": ["desktop-web", "worker", "admin", "docs"],
      "ownership": "starter-owned",
      "source": [
        { "name": "Better Auth API Key plugin", "url": "https://better-auth.com/docs/plugins/api-key", "relationship": "tracked-upstream" }
      ],
      "updatePolicy": "stable-aligned",
      "provides": ["API keys", "scopes", "signed outbound webhooks", "usage records", "developer docs"],
      "requires": ["identity core", "aligned Better Auth plugin line", "project-specific quotas"],
      "conflicts": ["plaintext API key storage", "unbounded usage writes"],
      "performance": ["hashed key lookup", "batched usage writes", "bounded webhook retries"],
      "verification": ["key lifecycle", "scope denial", "webhook signing and replay", "usage boundaries"],
      "documentation": ["ARCHITECTURE.md", "features/admin/MODULE.md", "features/docs/MODULE.md"]
    },
    {
      "id": "capability.mapcn-web",
      "kind": "capability",
      "name": "MapCN Web maps",
      "version": "0.1.0",
      "status": "planned",
      "targets": ["desktop-web", "admin"],
      "ownership": "starter-owned",
      "source": [
        {
          "name": "MapCN",
          "url": "https://www.mapcn.dev/",
          "revision": "d5d287dfdb214c349342f30e407a7c6cf81c4e84",
          "license": "MIT",
          "relationship": "adapted-donor"
        },
        {
          "name": "MapLibre GL JS",
          "url": "https://maplibre.org/maplibre-gl-js/docs/",
          "relationship": "runtime-dependency"
        }
      ],
      "updatePolicy": "runtime-stable",
      "provides": ["owned shadcn-aligned Web map components", "MapLibre rendering", "lazy map route boundary"],
      "requires": ["explicit Blueprint selection", "map style and data source configuration"],
      "conflicts": ["native Expo target", "eager loading on non-map routes"],
      "performance": ["dynamic import", "map assets excluded from core Web bundle", "viewport-bounded data loading"],
      "verification": ["map route smoke", "bundle isolation", "keyboard and reduced-motion checks"],
      "documentation": ["features/assembler/MODULE.md", "PERFORMANCE.md"]
    }
  ]
}
