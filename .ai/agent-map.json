      "moduleIds": ["auth", "account-security"],
      "primaryFiles": ["workers/app/auth-config.ts", "workers/app/auth-runtime.ts", "workers/app/index.ts", "apps/web/src/components/auth-page.tsx", "apps/web/src/components/account-control.tsx", "apps/web/src/components/account-settings.tsx"],
      "docs": ["features/auth/MODULE.md", "features/account-security/MODULE.md"],
      "checks": ["npm run auth:social:contract", "npm run auth:email:contract", "npm run auth:smoke:dev"],
      "skills": []
    },
    {
      "id": "product-shell",
