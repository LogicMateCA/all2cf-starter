{
  "schemaVersion": "starter-agent-map/v1",
  "version": "1.0.0",
  "defaultReads": [
    "AGENTS.md",
    "AGENT_MAP.md",
    "starter.blueprint.json",
    ".starter/materialization.json"
  ],
  "firstRunReads": [
    "PROJECT.md",
    "starter.config.json",
    "catalog/catalog.json",
    "catalog/providers.json",
    "pages/catalog.json",
    "design/stylekit/source-catalog.json",
    "skills/starter-bootstrap/SKILL.md"
  ],
  "rules": {
    "routine": "Start with the default reads and one matched route. Do not read every module or Change Spec.",
    "history": "Search changes/ by task terms and affectedModules; read only the newest directly relevant specs.",
    "packs": "For reusable Pack behavior, edit the Pack template/manifest and materialize. Never patch only a receipt-owned target.",
    "product": "For copied-product business behavior, edit the product-owned target and update its module contract; do not generalize it back into Starter without an explicit decision.",
    "release": "Read the exact release Skill only for build, deploy, rollback, or provider operations. Production still requires explicit wording."
  },
  "routes": [
    {
      "id": "project-assembly",
      "summary": "Source Factory, reproducible Engine candidates, monotonic update Channels, repeatable update releases, generated-project Setup, Blueprint selection, verified lifecycle updates, Pack materialization, identity synchronization, and /dp generation.",
      "triggers": ["factory", "source release", "engine candidate", "engine channel", "engine update", "check starter updates", "publish starter development", "capsule", "engine register", "create project", "generated project update", "setup", "blueprint", "preset", "materialize", "starter status", "starter diff", "starter add", "starter update", "assembler", "identity sync", "源库发布", "检查 Starter 更新", "发布 Starter 开发版", "生成项目", "项目更新", "初始化", "配置", "模板", "选择模块"],
      "moduleIds": ["assembler"],
      "primaryFiles": ["apps/web/src/components/setup-page.tsx", "apps/web/vite.config.ts", "scripts/starter-factory.mjs", "scripts/source-release.mjs", "scripts/materialize-blueprint.mjs", "scripts/sync-project-identity.mjs", "starter.blueprint.json", "catalog/catalog.json"],
      "docs": ["features/assembler/MODULE.md", "PROJECT.md"],
      "checks": ["npm run source:status", "npm run factory:contract", "npm run starter:materialize:check", "npm run saas:contract", "npm run knowledge:check"],
      "skills": ["skills/project-context/SKILL.md", "skills/starter-bootstrap/SKILL.md", "skills/starter-source-release/SKILL.md", "skills/starter-update-release/SKILL.md"]
    },
    {
      "id": "auth-account",
      "summary": "Better Auth, social login, email verification, sessions, account preferences, 2FA, and account menu.",
