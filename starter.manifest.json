{
  "$schema": "./schemas/starter-manifest.schema.json",
  "starterVersion": "0.1.0",
  "state": "production_released",
  "runtime": {
    "application": "cloudflare-workerd",
    "tooling": "node-24",
    "deployment": "wrangler"
  },
  "applications": [
    "web",
    "worker",
    "mobile",
    "docs"
  ],
  "modules": [
    "assembler",
    "auth",
    "billing",
    "support",
    "admin",
    "mobile",
    "docs"
  ],
  "technology": [
    {
      "area": "Project configuration",
      "choice": "Local-only /setup + starter.blueprint.json + owned Design/Page/SaaS/Capability Catalog",
      "status": "local-verified"
    },
    {
      "area": "Project materialization",
      "choice": "Deterministic selected-pack application with drift and removal plans",
      "status": "planned"
    },
    {
      "area": "Design engine",
      "choice": "Pinned owned profiles with semantic tokens, AI rules, provenance, and per-platform adapters",
      "status": "defined"
    },
    {
      "area": "Web",
      "choice": "React 19.2.3 + Vite 8.2.2",
      "status": "local-verified"
    },
    {
      "area": "Worker",
      "choice": "Hono 4.13.3 + Cloudflare workerd via Wrangler 4.124.0",
      "status": "local-verified"
    },
    {
      "area": "Database",
      "choice": "PostgreSQL 18.4 + node-postgres 8.23.0 + checksum-locked SQL-first migrations",
      "status": "development-verified"
    },
    {
      "area": "Connection",
      "choice": "Cloudflare Hyperdrive",
      "status": "implemented"
    },
    {
      "area": "Authentication",
      "choice": "Better Auth 1.7.1 aligned across core and Expo with issuer-scoped empty-database baseline",
      "status": "local-verified"
    },
    {
      "area": "Billing",
      "choice": "@better-auth/stripe aligned with Better Auth + Stripe SDK stable compatible",
      "status": "planned"
    },
    {
      "area": "Email",
      "choice": "CFsend default; Resend switch; optional Cloudflare Email Service; provider-backed auth outbox",
      "status": "local-verified"
    },
    {
      "area": "Web UI",
      "choice": "Owned shadcn/ui source components + Tailwind",
      "status": "implemented"
    },
    {
      "area": "Web charts",
      "choice": "shadcn Chart over Recharts 3.10.1; Bklit advanced and ECharts heavy analytics opt-in",
      "status": "implemented"
    },
    {
      "area": "Mobile",
      "choice": "Expo 57.0.14 + React Native 0.86.2 + Tamagui 2.7.7 for Mobile Web/iOS/Android",
      "status": "local-verified"
    },
    {
      "area": "Cloudflare release",
      "choice": "Dev + Production + verified Dev rollback",
      "status": "verified"
    },
    {
      "area": "Expo release",
      "choice": "EAS Build, Update and store contract",
      "status": "remote-unverified"
    },
    {
      "area": "Runtime upgrades",
      "choice": "Stable-compatible policy; current refresh requires Development publication before acceptance",
      "status": "local-verified"
    },
    {
      "area": "Starter bootstrap",
      "choice": "Environment materialization + idempotent PostgreSQL/VPC/Hyperdrive provisioning",
      "status": "verified"
    },
    {
      "area": "Project context",
      "choice": "Blueprint + Catalog + Change Specs + Markdown-source /dp synchronization",
      "status": "development-verified"
    },
    {
      "area": "Docs",
      "choice": "Astro Starlight",
      "status": "planned"
    },
    {
      "area": "AI controller",
      "choice": "GPT-5.6 Sol high",
      "status": "defined"
    },
    {
      "area": "AI workers",
      "choice": "GPT-5.6 Luna medium",
      "status": "defined"
    },
    {
      "area": "Cloudflare context",
      "choice": "Official MCP + Worker Studio MCP",
      "status": "defined"
    }
  ],
  "environments": [
    {
      "id": "development",
      "worker": "starter-dev",
      "domain": "dev.logicm8.com",
      "releaseIntent": "发布"
    },
    {
      "id": "production",
      "worker": "starter",
      "domain": "starter.logicm8.com",
      "releaseIntent": "正式发布"
    }
  ],
  "ai": {
    "entrypoint": "AGENTS.md",
    "projectContext": "PROJECT.md",
    "contextCommand": "npm run ai:context -- --json",
    "doctorCommand": "npm run ai:doctor"
  },
  "project": {
    "name": "Cloudflare AI Starter",
    "slug": "starter"
  }
}
