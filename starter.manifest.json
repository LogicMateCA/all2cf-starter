{
  "$schema": "./schemas/starter-manifest.schema.json",
  "starterVersion": "0.1.0",
  "state": "production_released",
  "runtime": {
    "application": "cloudflare-workerd",
    "tooling": "node-24",
    "deployment": "wrangler"
  },
  "applications": [
    "web",
    "worker",
    "mobile",
    "docs"
  ],
  "modules": [
    "auth",
    "billing",
    "support",
    "admin",
    "mobile",
    "docs"
  ],
  "technology": [
    {
      "area": "Web",
      "choice": "React 19.2.3 + Vite 8.2.1",
      "status": "implemented"
    },
    {
      "area": "Worker",
      "choice": "Hono 4.13.2 + Cloudflare workerd via Wrangler 4.123.0",
      "status": "implemented"
    },
    {
      "area": "Database",
      "choice": "PostgreSQL 18.4 + node-postgres 8.23.0 connection; SQL-first migrations planned",
      "status": "connection-verified"
    },
    {
      "area": "Connection",
      "choice": "Cloudflare Hyperdrive",
      "status": "implemented"
    },
    {
      "area": "Authentication",
      "choice": "Better Auth stable line (current target 1.6.29)",
      "status": "planned"
    },
    {
      "area": "Billing",
      "choice": "@better-auth/stripe aligned with Better Auth + Stripe SDK stable compatible",
      "status": "planned"
    },
    {
      "area": "Email",
      "choice": "CFsend",
      "status": "planned"
    },
    {
      "area": "Web UI",
      "choice": "Owned shadcn/ui components",
      "status": "planned"
    },
    {
      "area": "Web charts",
      "choice": "shadcn Chart + Bklit; ECharts for heavy analytics",
      "status": "defined"
    },
    {
      "area": "Mobile",
      "choice": "Expo 57.0.13 + React Native 0.86.2 + EAS CLI 22; owned thin UI seam, Tamagui optional template",
      "status": "local-verified"
    },
    {
      "area": "Cloudflare release",
      "choice": "Dev + Production + verified Dev rollback",
      "status": "verified"
    },
    {
      "area": "Expo release",
      "choice": "EAS Build, Update and store contract",
      "status": "remote-unverified"
    },
    {
      "area": "Runtime upgrades",
      "choice": "Stable-compatible policy + verified Development release",
      "status": "verified"
    },
    {
      "area": "Starter bootstrap",
      "choice": "Environment materialization + idempotent PostgreSQL/VPC/Hyperdrive provisioning",
      "status": "verified"
    },
    {
      "area": "Project context",
      "choice": "Commit-level Change Specs + Markdown-source /dp synchronization",
      "status": "development-verified"
    },
    {
      "area": "Docs",
      "choice": "Astro Starlight",
      "status": "planned"
    },
    {
      "area": "AI controller",
      "choice": "GPT-5.6 Sol high",
      "status": "defined"
    },
    {
      "area": "AI workers",
      "choice": "GPT-5.6 Luna medium",
      "status": "defined"
    },
    {
      "area": "Cloudflare context",
      "choice": "Official MCP + Worker Studio MCP",
      "status": "defined"
    }
  ],
  "environments": [
    {
      "id": "development",
      "worker": "starter-dev",
      "domain": "dev.logicm8.com",
      "releaseIntent": "发布"
    },
    {
      "id": "production",
      "worker": "starter",
      "domain": "starter.logicm8.com",
      "releaseIntent": "正式发布"
    }
  ],
  "ai": {
    "entrypoint": "AGENTS.md",
    "projectContext": "PROJECT.md",
    "contextCommand": "npm run ai:context -- --json",
    "doctorCommand": "npm run ai:doctor"
  },
  "project": {
    "name": "Cloudflare AI Starter",
    "slug": "starter"
  }
}
