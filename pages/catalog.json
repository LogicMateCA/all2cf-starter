      "route": "/",
      "group": "marketing",
      "renderer": "astro-static",
      "required": true,
      "defaultSelected": true,
    "status": "local-verified",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["navigation", "hero", "trust", "value", "proof", "call-to-action", "footer"],
      "acceptance": ["clear product promise", "single primary action", "static HTML without required client JavaScript"]
    },
    {
