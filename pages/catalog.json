{
  "$schema": "../schemas/page-catalog.schema.json",
  "schemaVersion": "starter-page-catalog/v1",
  "catalogVersion": "0.4.0",
  "policy": "Routes are selected explicitly in the Project Blueprint. Public pages are static-first, authenticated product routes stay in the React application, and Docs use Starlight. Unselected optional routes are not materialized.",
  "donorAudit": {
    "name": "PowerAI Astro",
    "url": "https://github.com/sitepins/powerai-astro",
    "revision": "a1176bf882bf0b1af98115f3280c2a6928e69261",
    "license": "MIT",
    "accepted": [
      "public page information architecture",
      "hero, trust, feature, pricing, FAQ, testimonial, CTA, and footer section patterns",
      "content-collection patterns for changelog and optional growth pages"
    ],
    "rejected": [
      "PowerAI brand, theme, demo content, fonts, and assets",
      "PowerAI login and sign-up behavior",
      "eager React islands and decorative motion without product value",
      "automatic upstream synchronization"
    ],
    "decisions": [
      { "sourcePath": "src/pages/[regular].astro", "disposition": "rejected", "reason": "A generic runtime Markdown route would hide ownership, authorization, and content indexing boundaries; explicit Starter routes and Docs own this surface." },
      { "sourcePath": "src/pages/login.astro", "disposition": "replaced", "reason": "The visual entry is retained, but Better Auth owns authentication behavior and the Starter React auth route owns implementation.", "replacement": "apps/web /login Better Auth shell" },
      { "sourcePath": "src/pages/sign-up.astro", "disposition": "replaced", "reason": "The donor signup behavior is not copied; Better Auth owns registration, email verification, and enumeration-safe responses.", "replacement": "apps/web Better Auth registration flow" }
    ]
  },
  "sourceInventory": {
    "sourceRoot": "PowerAI Astro/src/pages",
    "routeFiles": [
      { "path": "src/pages/404.astro", "family": "system.not-found", "kind": "not-found", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/[regular].astro", "family": "content.generic-markdown", "kind": "dynamic", "status": "rejected", "disposition": "rejected" },
      { "path": "src/pages/about.astro", "family": "company.about", "kind": "static", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/blog/[single].astro", "family": "growth.blog", "kind": "detail", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/blog/index.astro", "family": "growth.blog", "kind": "index", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/blog/page/[page].astro", "family": "growth.blog", "kind": "pagination", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/careers/[single].astro", "family": "growth.careers", "kind": "detail", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/careers/index.astro", "family": "growth.careers", "kind": "index", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/case-studies/[single].astro", "family": "growth.case-studies", "kind": "detail", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/case-studies/index.astro", "family": "growth.case-studies", "kind": "index", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/case-studies/page/[page].astro", "family": "growth.case-studies", "kind": "pagination", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/changelog.astro", "family": "product.changelog", "kind": "static", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/contact.astro", "family": "company.contact", "kind": "static", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/features.astro", "family": "marketing.features", "kind": "static", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/index.astro", "family": "marketing.home", "kind": "static", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/integrations/[single].astro", "family": "growth.integrations", "kind": "detail", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/integrations/index.astro", "family": "growth.integrations", "kind": "index", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/login.astro", "family": "auth.login", "kind": "auth", "status": "replaced", "disposition": "replaced" },
      { "path": "src/pages/pricing.astro", "family": "marketing.pricing", "kind": "static", "status": "adapted", "disposition": "accepted" },
      { "path": "src/pages/sign-up.astro", "family": "auth.sign-up", "kind": "auth", "status": "replaced", "disposition": "replaced" }
    ],
    "contentCollections": [
      { "name": "blog", "sourcePath": "src/content/blog", "role": "index, detail, pagination content", "status": "adapted", "disposition": "accepted" },
      { "name": "careers", "sourcePath": "src/content/careers", "role": "role index, role detail, application content", "status": "adapted", "disposition": "accepted" },
      { "name": "case-studies", "sourcePath": "src/content/case-studies", "role": "case index, case detail, outcomes", "status": "adapted", "disposition": "accepted" },
      { "name": "integrations", "sourcePath": "src/content/integrations", "role": "integration index and detail", "status": "adapted", "disposition": "accepted" },
      { "name": "pages", "sourcePath": "src/content/pages", "role": "explicit Markdown pages only", "status": "planned", "disposition": "replaced" },
      { "name": "sections", "sourcePath": "src/content/sections", "role": "section recipes and content fragments", "status": "donor-only", "disposition": "accepted" }
    ],
    "routeFamilies": [
      { "id": "growth.blog", "baseRoute": "/blog", "packId": "page.optional-growth", "index": { "sourcePath": "src/pages/blog/index.astro", "route": "/blog", "status": "adapted", "disposition": "accepted" }, "detail": { "sourcePath": "src/pages/blog/[single].astro", "route": "/blog/:slug", "status": "adapted", "disposition": "accepted" }, "pagination": { "sourcePath": "src/pages/blog/page/[page].astro", "route": "/blog/page/:page", "status": "adapted", "disposition": "accepted" }, "contentCollection": "blog", "status": "implemented" },
      { "id": "growth.case-studies", "baseRoute": "/case-studies", "packId": "page.optional-growth", "index": { "sourcePath": "src/pages/case-studies/index.astro", "route": "/case-studies", "status": "adapted", "disposition": "accepted" }, "detail": { "sourcePath": "src/pages/case-studies/[single].astro", "route": "/case-studies/:slug", "status": "adapted", "disposition": "accepted" }, "pagination": { "sourcePath": "src/pages/case-studies/page/[page].astro", "route": "/case-studies/page/:page", "status": "adapted", "disposition": "accepted" }, "contentCollection": "case-studies", "status": "implemented" },
      { "id": "growth.careers", "baseRoute": "/careers", "packId": "page.optional-growth", "index": { "sourcePath": "src/pages/careers/index.astro", "route": "/careers", "status": "adapted", "disposition": "accepted" }, "detail": { "sourcePath": "src/pages/careers/[single].astro", "route": "/careers/:slug", "status": "adapted", "disposition": "accepted" }, "pagination": null, "contentCollection": "careers", "status": "implemented" },
      { "id": "growth.integrations", "baseRoute": "/integrations", "packId": "page.optional-growth", "index": { "sourcePath": "src/pages/integrations/index.astro", "route": "/integrations", "status": "adapted", "disposition": "accepted" }, "detail": { "sourcePath": "src/pages/integrations/[single].astro", "route": "/integrations/:slug", "status": "adapted", "disposition": "accepted" }, "pagination": null, "contentCollection": "integrations", "status": "implemented" },
      { "id": "content.generic-markdown", "baseRoute": "/:slug", "packId": "page.core-product-site", "index": null, "detail": { "sourcePath": "src/pages/[regular].astro", "route": "/:slug", "status": "rejected", "disposition": "rejected" }, "pagination": null, "contentCollection": "pages", "status": "planned" }
    ],
    "donorDecisions": [
      { "sourcePath": "src/pages/[regular].astro", "disposition": "rejected", "reason": "Use explicit owned routes or Starlight; do not expose an unbounded generic route." },
      { "sourcePath": "src/pages/login.astro", "disposition": "replaced", "reason": "Use Better Auth behavior with the selected StyleKit visual adapter.", "replacement": "apps/web /login" },
      { "sourcePath": "src/pages/sign-up.astro", "disposition": "replaced", "reason": "Use Better Auth registration and mandatory verification.", "replacement": "Better Auth registration flow" }
    ]
  },
  "pages": [
    {
    "id": "marketing.home",
      "packId": "page.core-product-site",
