{
  "$schema": "../schemas/page-catalog.schema.json",
  "schemaVersion": "starter-page-catalog/v1",
  "catalogVersion": "0.2.0",
  "policy": "Routes are selected explicitly in the Project Blueprint. Public pages are static-first, authenticated product routes stay in the React application, and Docs use Starlight. Unselected optional routes are not materialized.",
  "donorAudit": {
    "name": "PowerAI Astro",
    "url": "https://github.com/sitepins/powerai-astro",
    "revision": "a1176bf882bf0b1af98115f3280c2a6928e69261",
    "license": "MIT",
    "accepted": [
      "public page information architecture",
      "hero, trust, feature, pricing, FAQ, testimonial, CTA, and footer section patterns",
      "content-collection patterns for changelog and optional growth pages"
    ],
    "rejected": [
      "PowerAI brand, theme, demo content, fonts, and assets",
      "PowerAI login and sign-up behavior",
      "eager React islands and decorative motion without product value",
      "automatic upstream synchronization"
    ]
  },
  "pages": [
    {
      "id": "marketing.home",
      "packId": "page.core-product-site",
      "name": "Home",
      "route": "/",
      "group": "marketing",
      "renderer": "astro-static",
      "required": true,
      "defaultSelected": true,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["navigation", "hero", "trust", "value", "proof", "call-to-action", "footer"],
      "acceptance": ["clear product promise", "single primary action", "static HTML without required client JavaScript"]
    },
    {
      "id": "marketing.features",
      "packId": "page.core-product-site",
      "name": "Features",
      "route": "/features",
      "group": "marketing",
      "renderer": "astro-static",
      "required": false,
      "defaultSelected": true,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["page-intro", "feature-groups", "proof", "faq", "call-to-action"],
      "acceptance": ["capabilities grouped by user outcome", "no invented product claims"]
    },
    {
      "id": "marketing.pricing",
      "packId": "page.core-product-site",
      "name": "Pricing",
      "route": "/pricing",
      "group": "marketing",
      "renderer": "astro-static",
      "required": false,
      "defaultSelected": true,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["page-intro", "plan-comparison", "billing-faq", "call-to-action"],
      "acceptance": ["works without Stripe selected", "billing actions become live only with billing capability"]
    },
    {
      "id": "company.about",
      "packId": "page.core-product-site",
      "name": "About",
      "route": "/about",
      "group": "company",
      "renderer": "astro-static",
      "required": false,
      "defaultSelected": true,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["page-intro", "mission", "principles", "team-or-founder", "call-to-action"],
      "acceptance": ["content comes from project brief", "team section may be omitted"]
    },
    {
      "id": "company.contact",
      "packId": "page.core-product-site",
      "name": "Contact",
      "route": "/contact",
      "group": "company",
      "renderer": "astro-static",
      "required": false,
      "defaultSelected": true,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["page-intro", "contact-options", "validated-form", "response-expectation"],
      "acceptance": ["server-owned submission", "spam and rate-limit contract before release"]
    },
    {
      "id": "product.changelog",
      "packId": "page.core-product-site",
      "name": "Changelog",
      "route": "/changelog",
      "group": "product",
      "renderer": "astro-static",
      "required": false,
      "defaultSelected": true,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["page-intro", "version-feed", "release-links"],
      "acceptance": ["Markdown-backed", "dated entries", "no dependency on the internal Change Spec format"]
    },
    {
      "id": "legal.privacy",
      "packId": "page.core-product-site",
      "name": "Privacy",
      "route": "/privacy",
      "group": "legal",
      "renderer": "astro-static",
      "required": true,
      "defaultSelected": true,
      "status": "implemented",
      "sourceStrategy": "starter-original",
      "sections": ["policy-content", "effective-date", "contact"],
      "acceptance": ["project-specific placeholders are explicit", "legal review is not implied"]
    },
    {
      "id": "legal.terms",
      "packId": "page.core-product-site",
      "name": "Terms",
      "route": "/terms",
      "group": "legal",
      "renderer": "astro-static",
      "required": true,
      "defaultSelected": true,
      "status": "implemented",
      "sourceStrategy": "starter-original",
      "sections": ["terms-content", "effective-date", "contact"],
      "acceptance": ["project-specific placeholders are explicit", "legal review is not implied"]
    },
    {
      "id": "auth.login",
      "packId": "page.core-product-site",
      "name": "Sign in",
      "route": "/login",
      "group": "auth",
      "renderer": "react-app",
      "required": true,
      "defaultSelected": true,
      "status": "local-verified",
      "sourceStrategy": "starter-original",
      "sections": ["identity-method", "credential-flow", "verification-state", "recovery-entry"],
      "acceptance": ["Better Auth owns behavior", "mandatory verification", "enumeration-safe public responses"]
    },
    {
      "id": "auth.account",
      "packId": "page.core-product-site",
      "name": "Account and settings",
      "route": "/app/settings",
      "group": "auth",
      "renderer": "react-app",
      "required": true,
      "defaultSelected": true,
      "status": "local-verified",
      "sourceStrategy": "starter-original",
      "sections": ["profile", "appearance", "language", "security-entry", "sign-out"],
      "acceptance": ["authenticated route", "theme and locale persist to the user profile"]
    },
    {
      "id": "docs.public",
      "packId": "page.core-product-site",
      "name": "Public docs",
      "route": "/docs",
      "group": "docs",
      "renderer": "starlight",
      "required": true,
      "defaultSelected": true,
      "status": "local-verified",
      "sourceStrategy": "starter-original",
      "sections": ["getting-started", "product-guides", "reference", "operations"],
      "acceptance": ["Markdown source", "searchable", "separate from internal /dp"]
    },
    {
      "id": "system.not-found",
      "packId": "page.core-product-site",
      "name": "Not found",
      "route": "/404",
      "group": "system",
      "renderer": "astro-static",
      "required": true,
      "defaultSelected": true,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["error-message", "recovery-actions"],
      "acceptance": ["real 404 response", "route back to a useful product surface"]
    },
    {
      "id": "support.portal",
      "packId": "saas.product-operations-lite",
      "name": "Support and bug intake",
      "route": "/support",
      "group": "product",
      "renderer": "react-app",
      "required": true,
      "defaultSelected": true,
      "status": "local-verified",
      "sourceStrategy": "starter-original",
      "sections": ["support-or-bug-intake", "validation", "own-ticket-history", "status"],
      "acceptance": ["verified account required", "five submissions per account per hour", "users can read only their own tickets"]
    },
    {
      "id": "admin.operations",
      "packId": "saas.product-operations-lite",
      "name": "Product operations Admin",
      "route": "/admin",
      "group": "product",
      "renderer": "react-app",
      "required": true,
      "defaultSelected": true,
      "status": "local-verified",
      "sourceStrategy": "starter-original",
      "sections": ["better-auth-user-readback", "support-inbox", "ticket-status", "audit-evidence"],
      "acceptance": ["Better Auth platform admin role required", "organization roles do not grant access", "privileged support mutations are audited"]
    },
    {
      "id": "growth.blog",
      "packId": "page.optional-growth",
      "name": "Blog",
      "route": "/blog",
      "group": "growth",
      "renderer": "astro-static",
      "required": false,
      "defaultSelected": false,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
