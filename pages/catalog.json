    {
      "id": "growth.integrations",
      "packId": "page.optional-growth",
      "name": "Integrations",
      "route": "/integrations",
      "group": "growth",
      "renderer": "astro-static",
      "required": false,
      "defaultSelected": false,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["integration-index", "integration-detail", "availability-state"],
      "acceptance": ["only real integrations are published", "content collection"]
    },
    {
      "id": "growth.careers",
      "packId": "page.optional-growth",
      "name": "Careers",
      "route": "/careers",
      "group": "growth",
      "renderer": "astro-static",
      "required": false,
      "defaultSelected": false,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["role-index", "role-detail", "application-path"],
      "acceptance": ["content collection", "application destination is configured"]
    }
  ]
}
