      "required": false,
      "defaultSelected": true,
    "status": "local-verified",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["page-intro", "feature-groups", "proof", "faq", "call-to-action"],
      "acceptance": ["capabilities grouped by user outcome", "no invented product claims"]
    },
    {
