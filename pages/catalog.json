      "route": "/case-studies",
      "group": "growth",
      "renderer": "astro-static",
      "required": false,
      "defaultSelected": false,
      "status": "implemented",
      "sourceStrategy": "powerai-structure-adapted",
      "sections": ["case-index", "case-detail", "outcomes", "call-to-action"],
