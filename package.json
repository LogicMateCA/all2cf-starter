    "dev:web": "npm run build:dp && cd apps/web && vite",
    "dev:worker": "node scripts/local-worker.mjs",
    "dev:docs": "npm run dev --workspace apps/docs",
    "setup": "npm run build:dp && npm run dev --workspace apps/web",
