{
  "name": "@starter/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "ai:context": "node scripts/ai-context.mjs",
    "ai:doctor": "node scripts/ai-doctor.mjs",
    "credentials:doctor": "node scripts/credentials-doctor.mjs",
    "identity:sync": "node scripts/sync-project-identity.mjs",
    "cf:preflight:record": "node scripts/record-cloudflare-preflight.mjs",
    "dependencies:check": "node scripts/dependency-check.mjs",
    "env:materialize:dev": "node scripts/materialize-dev-env.mjs",
    "starter:provision": "node scripts/starterctl.mjs provision",
    "release:dev": "node scripts/starterctl.mjs release development",
    "release:production": "node scripts/starterctl.mjs release production",
    "rollback:dev": "node scripts/starterctl.mjs rollback development",
    "rollback:production": "node scripts/starterctl.mjs rollback production",
    "mobile:doctor": "node scripts/mobile-release.mjs doctor",
    "mobile:dependencies:check": "cd apps/mobile && npx expo install --check",
    "mobile:verify": "node scripts/mobile-release.mjs verify",
    "mobile:plan:dev": "node scripts/mobile-release.mjs plan development",
    "mobile:plan:preview": "node scripts/mobile-release.mjs plan preview",
    "mobile:plan:production": "node scripts/mobile-release.mjs plan production",
    "mobile:release:dev": "node scripts/mobile-release.mjs release development",
    "mobile:release:preview": "node scripts/mobile-release.mjs release preview",
    "mobile:release:production": "node scripts/mobile-release.mjs release production",
    "mobile:record-e2e": "node scripts/mobile-release.mjs record-e2e",
    "knowledge:sync": "node scripts/build-dp.mjs",
    "knowledge:check": "node scripts/knowledge-check.mjs",
    "change:check": "node scripts/change-spec-check.mjs",
    "build:dp": "npm run knowledge:sync",
    "build:web": "npm run build --workspace apps/web",
    "bundle:check:web": "node scripts/bundle-budget.mjs web",
    "bundle:check:mobile": "node scripts/bundle-budget.mjs mobile",
    "build": "npm run build:dp && npm run build:web",
    "dev:web": "npm run build:dp && npm run dev --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "cf:types": "wrangler types --config cloudflare/wrangler.development.jsonc workers/app/worker-configuration.development.d.ts && wrangler types --config cloudflare/wrangler.production.jsonc workers/app/worker-configuration.production.d.ts",
    "cf:types:check": "wrangler types --check --config cloudflare/wrangler.development.jsonc workers/app/worker-configuration.development.d.ts && wrangler types --check --config cloudflare/wrangler.production.jsonc workers/app/worker-configuration.production.d.ts",
    "cf:dry-run:dev": "wrangler deploy --dry-run --config cloudflare/wrangler.development.jsonc --outdir dist/worker-development",
    "cf:dry-run:production": "wrangler deploy --dry-run --config cloudflare/wrangler.production.jsonc --outdir dist/worker-production",
    "verify": "npm run ai:doctor && npm run knowledge:sync && npm run knowledge:check && npm run change:check && npm run cf:types && npm run cf:types:check && npm run typecheck && npm run build && npm run bundle:check:web && npm run cf:dry-run:dev && npm run cf:dry-run:production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260817.1",
    "@types/node": "24.13.3",
    "jsonc-parser": "3.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "7.0.2",
    "wrangler": "4.123.0",
    "yaml": "2.9.0"
  }
}
